{
  "version": 2,
  "redirects": [
    {
      "source": "/",
      "destination": "/gcfm",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/api/:path*",  "destination": "/api/index.ts" },
    { "source": "/og/:slug",    "destination": "/api/index.ts" },
    { "source": "/(.*)",        "destination": "/index.html" }
  ]
}